{
  "name": "buildergame",
  "private": true,
  "version": "0.1.0",
  "description": "A creative voxel building game: build structures, place them in your world, and share them as files.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "balance": "tsx scripts/balance.ts",
    "bots": "tsx bots/run.ts",
    "bots:compare": "tsx bots/compare.ts",
    "bots:verify": "tsx bots/verify.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
